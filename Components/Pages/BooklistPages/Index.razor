@page "/books"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using CSE325_Team2_Project.Data
@using CSE325_Team2_Project.Models
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Book List</PageTitle>

<h1>Book List</h1>

<p>
    <a href="books/create">Add a new book to the list</a>
</p>

<QuickGrid Class="table" Items="context.Books">
    <PropertyColumn Property="book => book.Title" Sortable="true" />
    <PropertyColumn Property="book => book.Author" Sortable="true" />
    <PropertyColumn Property="book => book.PublishDate" Title="Published Date" Sortable="true" />
    <PropertyColumn Property="book => book.Genre" Sortable="true" />
    <PropertyColumn Property="book => book.IsSelected" Title="Book has been selected" />

    <TemplateColumn Context="book">
        <a href="@($"books/edit?id={book.Id}")">Edit</a> |
        <a href="@($"books/details?id={book.Id}")">Details</a> |
        <a href="@($"books/delete?id={book.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}